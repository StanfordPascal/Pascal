*
*
***************************************************************
*        DYNAMIC STORAGE AREA POINTED TO BY HEAPLIM
***************************************************************
*
DYN2STOR DSECT
DYNRUNC  DS    F                   # OF RUN TIME FREQUENCY COUNTERS
         DS    0D
DYNCOUNT DS    0F
         AIF   (&SYSTEM).SYS3
DYN2LEN  EQU   128                 EXTRA MARGIN FOR
*                                  PATHOLOGICAL CALL PARMS
