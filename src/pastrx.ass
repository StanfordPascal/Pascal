*
**************************************************************
*
*        GLOBAL TRACE ROUTINE
*
**************************************************************
*
*****************************************************************
*        PASTRACE - TRACE-AUSGABEN FUER MONITOR
*****************************************************************
*
$PASTRX  CSECT
         USING $PASTRX,R15
         STM   R13,R4,SAVETRAC
         LA    R13,SAVEPUTS
         LR    R4,R15
         DROP  R15
         USING $PASTRX,R4
         LTR   R3,R3
         BZ    $PASTRXO
         BNP   $PASTRXC
*
         CLI   TRACOPEN,1
         BNE   $PASTRXZ
         PUT   PASTRACE,0(R3)
         B     $PASTRXZ
*
$PASTRXO DS    0H
         OPEN  (PASTRACE,(OUTPUT))
*        PUT   PASTRACE,OPENMSG
         MVI   TRACOPEN,1
         B     $PASTRXZ
*
$PASTRXC DS    0H
*        PUT   PASTRACE,CLOSMSG
         CLOSE (PASTRACE)
         MVI   TRACOPEN,0
         B     $PASTRXZ
*
$PASTRXZ DS    0H
         LM    R13,R4,SAVETRAC
         BR    R14
*
OPENMSG  DC    CL80'$PASTRX: NACH OPEN PASTRACE'
CLOSMSG  DC    CL80'$PASTRX: VOR CLOSE PASTRACE'
         DS    CL100
PASTRACE DCB   DDNAME=PASTRACE,DSORG=PS,MACRF=PM,RECFM=F,LRECL=80
TRACOPEN DC    X'0'
SAVETRAC DS    8F
SAVEPUTS DC    18F'0'
*
**************************************************************
*        REGISTER ASSIGNMENTS
**************************************************************
*
R0       EQU   0
R1       EQU   1
R2       EQU   2
R3       EQU   3
R4       EQU   4
R5       EQU   5
R6       EQU   6
R7       EQU   7
R8       EQU   8
R9       EQU   9
R10      EQU   10
R11      EQU   11
R12      EQU   12
R13      EQU   13
R14      EQU   14
R15      EQU   15
*
         END   $PASTRX
